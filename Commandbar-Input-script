local function enemiesForWave(w)
	if w==1 then return 3 end
	if w==2 then return 5 end
	if w==3 then return 7 end
	local tier = math.floor((w-1)/3)
	return 7 + tier*3 + (w%3)
end
local function enemyHP(w) return 60 + (w-1)*12 end
local function enemySpeed(w) return math.min(18, 4 + w*0.65) end

