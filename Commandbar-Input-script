		cam.CameraType=Enum.CameraType.Scriptable
		cam.CFrame=CFrame.new(camPos, hrp.Position + Vector3.new(0,0.1,0))
		cam.FieldOfView=44

		local mv=getMoveVec()
		if (mv-lastMoveSent).Magnitude>0.001 then
			lastMoveSent=mv
			RE_InputMove:FireServer(mv)
		end

		if not paused and alive then
			local m=plr:GetMouse()
			local ray=cam:ScreenPointToRay(m.X,m.Y)
			if math.abs(ray.Direction.Y)>0.00001 then
				local t=(1-ray.Origin.Y)/ray.Direction.Y
				local hit=ray.Origin + ray.Direction*t
				RE_InputLook:FireServer(hit)
			end
		end
	else
		cam.CameraType=Enum.CameraType.Custom
	end
end)
