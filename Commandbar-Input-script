	if not hum or not hrp then return end

	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.AutoRotate = false
	hum.PlatformStand = false
	for _,state in ipairs({Enum.HumanoidStateType.Jumping,Enum.HumanoidStateType.Freefall,Enum.HumanoidStateType.Swimming,Enum.HumanoidStateType.Climbing}) do
		hum:SetStateEnabled(state,false)
	end

	for _,d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then d.Transparency=1 d.CanCollide=false
