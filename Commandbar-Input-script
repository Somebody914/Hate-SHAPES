local function spawnBoomerang(plr, origin, dir, speed, damage, maxDistanceOut)
	local b = Instance.new("Part")
	b.Name = "BoomerangBullet"
	b.Anchored = true
	b.CanCollide = false
	b.Size = Vector3.new(0.4,0.4,2.1)
	b.Material = Enum.Material.Neon
	b.Color = Color3.fromRGB(170,255,140)
	b.CFrame = CFrame.new(origin, origin + dir)
	b.Parent = bulletsFolder

	local traveled = 0
	local returning = false

	local con
	con = RunService.Heartbeat:Connect(function(dt)
		if not b.Parent then con:Disconnect() return end
		if not returning then
			local step = speed*dt
			b.CFrame += b.CFrame.LookVector * step
			traveled += step
			if traveled >= maxDistanceOut then returning=true end
		else
			local st = S(plr)
			if st.hrp then
				local to = st.hrp.Position - b.Position
				if to.Magnitude > 0.01 then
					local u = to.Unit
					b.CFrame = CFrame.new(b.Position, b.Position + u)
					b.CFrame += b.CFrame.LookVector * speed * 1.05 * dt
					if to.Magnitude <= 3.2 then b:Destroy(); con:Disconnect(); return end
				end
			else
				b:Destroy(); con:Disconnect(); return
			end
		end
		if bulletHitCheck(b, damage) then con:Disconnect(); return end
	end)
end

local function spawnLaserTap(origin, dir, damage)
	local beam = Instance.new("Part")
	beam.Name = "Laser"
	beam.Anchored = true
	beam.CanCollide = false
	beam.Size = Vector3.new(0.35,0.35,70)
	beam.Material = Enum.Material.Neon
	beam.Color = Color3.fromRGB(255,255,120)
	beam.CFrame = CFrame.new(origin + dir*35, origin + dir*36)
	beam.Parent = bulletsFolder

	for _,e in ipairs(enemiesFolder:GetChildren()) do
		local hp = e:FindFirstChild("HP")
		if hp then
			local rel = e.Position - origin
			local proj = rel:Dot(dir)
			if proj > 0 and proj < 75 then
				local closest = origin + dir*proj
				local dist = (e.Position - closest).Magnitude
				if dist <= 2.4 then hp.Value -= damage end
			end
		end
	end
	Debris:AddItem(beam,0.12)
end

local function fireByAbility(plr)
	local st = S(plr)
	if not st.started or st.paused or not st.alive or not st.hrp then return end
	if tick() < st.shootCD then return end

	-- Flatten the Y axis so the bullet travels completely straight instead of angled toward the ground!
	local dir = (st.lookPos - st.hrp.Position)
	dir = Vector3.new(dir.X, 0, dir.Z)
	if dir.Magnitude < 0.01 then return end
	dir = dir.Unit

	local origin = st.hrp.Position + st.hrp.CFrame.LookVector*1.8 + Vector3.new(0,1.15,0)
	local baseDamage = 20
	local ability = st.ability

	if ability == "None" then
		st.shootCD = tick() + 0.11
		spawnLinearBullet(origin, dir, 170, baseDamage, 180)
	elseif ability == "Twin Shot" then
		st.shootCD = tick() + 0.12
		local perp = Vector3.new(-dir.Z,0,dir.X)
		spawnLinearBullet(origin + perp*0.8, dir, 170, baseDamage, 180)
		spawnLinearBullet(origin - perp*0.8, dir, 170, baseDamage, 180)
	elseif ability == "Boom Pop" then
		st.shootCD = tick() + 0.2
		spawnBoomBullet(origin, dir, 160, math.floor(baseDamage*1.5), 170)
	elseif ability == "Boomerang" then
		st.shootCD = tick() + 0.18
		spawnBoomerang(plr, origin, dir, 160, math.floor(baseDamage*1.35), 90)
	elseif ability == "Laser Tap" then
		st.shootCD = tick() + 0.26
		spawnLaserTap(origin, dir, math.floor(baseDamage*1.8))
	elseif ability == "Mini Sprinkler" then
		st.shootCD = tick() + 0.055
		local spread = math.rad(math.random(-8,8))
		local c, s = math.cos(spread), math.sin(spread)
		local d = Vector3.new(dir.X*c - dir.Z*s, 0, dir.X*s + dir.Z*c).Unit
		spawnLinearBullet(origin, d, 180, math.floor(baseDamage*0.75), 160)
	end

	RE_SFX:FireClient(plr, "Shoot")
end

local function updateMovement(dt, plr, st)
	if not st.started or st.paused or not st.alive or not st.hrp then return end
	local m = st.move
	if m.Magnitude > 1 then m = m.Unit end
	local speed = 35

	local nx = st.hrp.Position.X + m.X * speed * dt
	local nz = st.hrp.Position.Z + m.Y * speed * dt

	local cur = st.hrp.Position
	local pad = 2.0
	if not pointInObstacleXZ(nx,nz,pad) then
		cur = Vector3.new(nx,cur.Y,nz)
	else
		if not pointInObstacleXZ(nx,cur.Z,pad) then cur = Vector3.new(nx,cur.Y,cur.Z) end
		if not pointInObstacleXZ(cur.X,nz,pad) then cur = Vector3.new(cur.X,cur.Y,nz) end
	end
	cur = clampArena(cur)

	local look = Vector3.new(st.lookPos.X, cur.Y, st.lookPos.Z)
	if (look-cur).Magnitude > 0.01 then st.hrp.CFrame = CFrame.new(cur, look)
	else st.hrp.CFrame = CFrame.new(cur) end
end

local function runWaves(plr)
	local st = S(plr)
	if st.running then return end
	st.running = true
	task.spawn(function()
		while plr.Parent and st.started and st.alive do
			if st.paused then task.wait(0.1) else
				st.wave += 1
				regenPattern(); regenObstacles(st.wave); applyPalette(st.wave)
				RE_Wave:FireClient(plr, st.wave)
				task.wait(1.15)

				local count = enemiesForWave(st.wave)
				for i=1,count do
					if not st.started or not st.alive then break end
					spawnEnemy(st.wave)
					task.wait(math.max(0.18, 0.8 - st.wave*0.03))
				end

				while st.started and st.alive do
					if st.paused then task.wait(0.1) else
						local aliveEnemies = 0
						for _,e in ipairs(enemiesFolder:GetChildren()) do
							local hp = e:FindFirstChild("HP")
							if hp and hp.Value > 0 then aliveEnemies += 1 end
						end
						if aliveEnemies <= 0 then break end
						task.wait(0.2)
					end
				end
				task.wait(1.8)
			end
		end
		st.running = false
	end)
end

