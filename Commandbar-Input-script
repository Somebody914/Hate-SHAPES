local function pointInObstacleXZ(x,z,pad)
	pad = pad or 1.6
	for _,ob in ipairs(OBSTACLES) do
		if ob and ob.Parent then
			local sx = ob.Size.X*0.5 + pad
			local sz = ob.Size.Z*0.5 + pad
			if x > ob.Position.X-sx and x < ob.Position.X+sx and z > ob.Position.Z-sz and z < ob.Position.Z+sz then
				return true
			end
		end
	end
	return false
end

