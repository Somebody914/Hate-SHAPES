	if gp then return end
	if inp.KeyCode==Enum.KeyCode.Escape and started and alive then setPaused(not paused) end
	if inp.KeyCode==Enum.KeyCode.W then keyW=true end
	if inp.KeyCode==Enum.KeyCode.A then keyA=true end
	if inp.KeyCode==Enum.KeyCode.S then keyS=true end
	if inp.KeyCode==Enum.KeyCode.D then keyD=true end

	if inp.UserInputType == Enum.UserInputType.MouseButton1 then
		if started and alive and not paused then
			local now=tick()
			if now-lastShot>=shootCD then
				lastShot=now
				RE_InputShoot:FireServer()
			end
		end
	end
end)

