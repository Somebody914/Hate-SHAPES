local function regenObstacles(wave)
	clearFolder(obstacleFolder)
	OBSTACLES = {}
	local count = math.min(6 + wave, 24)
	local tries, placed = 0,0
	while placed < count and tries < count*25 do
		tries += 1
		local sx, sz = math.random(8,16), math.random(8,16)
		local x, z = math.random(-120,120), math.random(-70,70)
		if (Vector3.new(x,0,z)-Vector3.new(0,0,0)).Magnitude > 25 then
			local overlap = false
			for _,o in ipairs(OBSTACLES) do
				local dx = math.abs(x-o.Position.X)
				local dz = math.abs(z-o.Position.Z)
				if dx < (sx+o.Size.X)/2+4 and dz < (sz+o.Size.Z)/2+4 then overlap=true break end
			end
			if not overlap then
				local o = Instance.new("Part")
				o.Name = "Obstacle"
				o.Anchored = true
				o.CanCollide = true
				o.Size = Vector3.new(sx, math.random(4,8), sz)
				o.Position = Vector3.new(x,o.Size.Y/2,z)
				o.Material = Enum.Material.SmoothPlastic
				o.Parent = obstacleFolder

				local top = Instance.new("Part")
				top.Anchored = true
				top.CanCollide = false
				top.Size = Vector3.new(sx*0.95,0.3,sz*0.95)
				top.Position = Vector3.new(x,o.Size.Y+0.15,z)
				top.Material = Enum.Material.Neon
				top.Transparency = 0.15
				top.Parent = obstacleFolder

				table.insert(OBSTACLES, o)
				placed += 1
			end
		end
	end
end

local function applyPalette(wave)
	local palettes = {
		{Color3.fromRGB(25,85,170), Color3.fromRGB(90,190,255), Color3.fromRGB(12,35,80), Color3.fromRGB(255,170,60)},
		{Color3.fromRGB(110,30,95), Color3.fromRGB(255,95,195), Color3.fromRGB(50,10,45), Color3.fromRGB(100,250,210)},
		{Color3.fromRGB(30,120,70), Color3.fromRGB(100,255,150), Color3.fromRGB(15,60,35), Color3.fromRGB(255,220,80)},
		{Color3.fromRGB(100,50,20), Color3.fromRGB(255,150,75), Color3.fromRGB(48,22,8), Color3.fromRGB(90,210,255)},
		{Color3.fromRGB(20,95,100), Color3.fromRGB(90,240,255), Color3.fromRGB(10,45,55), Color3.fromRGB(255,105,125)},
		{Color3.fromRGB(85,25,120), Color3.fromRGB(185,95,255), Color3.fromRGB(40,12,65), Color3.fromRGB(95,255,140)},
	}
	local p = palettes[((wave-1)%#palettes)+1]
	local cf, cp, cb, co = p[1],p[2],p[3],p[4]
	floor.Color = cf
	for _,b in ipairs(borderFolder:GetChildren()) do if b:IsA("BasePart") then b.Color = cb end end
