local function rainbow() return Color3.fromHSV(math.random(),1,1) end

local function spawnLED(pos)
	local led = Instance.new("Part")
	led.Name = "LED"
	led.Anchored = true
	led.CanCollide = false
	led.Size = Vector3.new(0.95,0.95,0.95)
	led.Position = pos + Vector3.new(math.random(-2,2),1.0,math.random(-2,2))
	led.Material = Enum.Material.Neon
	led.Color = rainbow()
	led.Parent = ledsFolder

	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = "rbxassetid://9756362"
	mesh.Scale = Vector3.new(0.72,0.92,0.72)
	mesh.Parent = led

	local light = Instance.new("PointLight")
	light.Brightness = 1.5
	light.Range = 10
	light.Color = led.Color
	light.Parent = led

	local born = tick()
	local life = 8
	local spin = math.random(-260,260)

	local con
	con = RunService.Heartbeat:Connect(function(dt)
		if not led.Parent then con:Disconnect() return end
		led.CFrame = led.CFrame * CFrame.Angles(0, math.rad(spin*dt), 0)

		local nearest, nd = nil, 9999
		for _,plr in ipairs(Players:GetPlayers()) do
			local st = S(plr)
			if st.started and st.alive and not st.paused and st.hrp then
				local d = (st.hrp.Position - led.Position).Magnitude
				if d < nd then nd=d nearest=plr end
			end
		end

		if nearest then
			local st = S(nearest)
			local hrp = st.hrp
			if hrp then
				if nd <= 22 then
					local dir = hrp.Position - led.Position
					if dir.Magnitude > 0.01 then led.Position += dir.Unit * (36*dt) end
				end
				if (hrp.Position - led.Position).Magnitude <= 4.0 then
					st.leds += 1
					RE_HUD:FireClient(nearest, "LEDS", st.leds)
					RE_SFX:FireClient(nearest, "Collect")
					led:Destroy()
					return
				end
			end
		end

		if tick()-born >= life then
			local tw = TweenService:Create(led, TweenInfo.new(0.45), {Transparency=1, Size=Vector3.new(0.12,0.12,0.12)})
			tw:Play(); tw.Completed:Wait()
			if led then led:Destroy() end
		end
	end)
end

local function damagePlayer(plr, amt)
	local st = S(plr)
	if not st.started or st.paused or not st.alive then return end
	if tick() < st.invuln then return end
	st.invuln = tick() + 0.6
	st.hp = math.max(0, st.hp - amt)
	RE_Damage:FireClient(plr, st.hp, st.maxHp)
	RE_SFX:FireClient(plr, "Hit")
	if st.hp <= 0 then
		st.alive = false
		st.started = false
		RE_GameOver:FireClient(plr, st.wave, st.leds)
		clearRound()
	end
end

local PERSONALITIES = {
	{name="Noodle", mode="Direct"},
	{name="Pickle", mode="Orbit"},
	{name="Mochi",  mode="Zigzag"},
	{name="Toast",  mode="Dash"},
}

local function spawnEnemy(wave)
	local side = (math.random()<0.5) and -1 or 1
	local e = Instance.new("Part")
	e.Name = "Enemy"
	e.Anchored = true
	e.CanCollide = false
	e.Size = Vector3.new(2.2,2.2,2.2)
	e.Material = Enum.Material.Neon
	e.Color = Color3.fromRGB(255,70,70)
	e.Position = Vector3.new(side*140,1.2,math.random(-80,80))
	e.Parent = enemiesFolder

	local hp = Instance.new("IntValue", e); hp.Name="HP"; hp.Value = enemyHP(wave)
	local p = PERSONALITIES[math.random(1,#PERSONALITIES)]
	local q = Instance.new("StringValue", e); q.Name="Quirk"; q.Value = p.name

	local spd = enemySpeed(wave)
	local seed = math.random()*1000
	local dashTimer = 0

	local con
	con = RunService.Heartbeat:Connect(function(dt)
		if not e.Parent then con:Disconnect() return end
		local target, tpos, dist = nil,nil,99999
		for _,plr in ipairs(Players:GetPlayers()) do
			local st = S(plr)
			if st.started and st.alive and not st.paused and st.hrp then
				local d = (st.hrp.Position - e.Position).Magnitude
				if d < dist then dist=d target=plr tpos=st.hrp.Position end
			end
		end
		if not tpos then return end

		local dir = (tpos - e.Position)
		local move = Vector3.new(0,0,0)
		if dir.Magnitude > 0.01 then
			local u = dir.Unit
			if p.mode=="Direct" then move = u * spd * dt
			elseif p.mode=="Orbit" then
				local perp = Vector3.new(-u.Z,0,u.X)
				move = (perp*0.7 + u*0.65).Unit * (spd*0.95) * dt
			elseif p.mode=="Zigzag" then
				local perp = Vector3.new(-u.Z,0,u.X)
				local wobble = math.sin(tick()*4 + seed) * 0.8
				move = (u*0.8 + perp*wobble).Unit * (spd*1.03) * dt
			elseif p.mode=="Dash" then
				dashTimer += dt
				if dashTimer > 1.3 then move = u * (spd*2.4) * dt dashTimer = 0
				else move = u * (spd*0.45) * dt end
			end
		end

		local nx, nz = e.Position.X + move.X, e.Position.Z + move.Z
		if not pointInObstacleXZ(nx,nz,1.6) then
			e.Position = Vector3.new(nx,e.Position.Y,nz)
		else
			if not pointInObstacleXZ(nx,e.Position.Z,1.6) then e.Position = Vector3.new(nx,e.Position.Y,e.Position.Z)
			elseif not pointInObstacleXZ(e.Position.X,nz,1.6) then e.Position = Vector3.new(e.Position.X,e.Position.Y,nz) end
		end
		e.Position = clampArena(e.Position)

		if target then
			local st = S(target)
			if st.hrp and (st.hrp.Position - e.Position).Magnitude <= 2.7 then damagePlayer(target,14) end
		end

		if hp.Value <= 0 then
			boom(e.Position, e.Color)
			for i=1,math.random(1,5) do spawnLED(e.Position) end
			e:Destroy()
			con:Disconnect()
		end
	end)
end

local function bulletHitCheck(b, damage)
	local bp = b.Position
	for _,e in ipairs(enemiesFolder:GetChildren()) do
		local hp = e:FindFirstChild("HP")
		if hp and (e.Position - bp).Magnitude <= 2.2 then
			hp.Value -= damage
			if b and b.Parent then b:Destroy() end
			return true
		end
	end
	return false
end

local function spawnLinearBullet(origin, dir, speed, damage, maxDistance)
	local b = Instance.new("Part")
	b.Name = "Bullet"
	b.Anchored = true
	b.CanCollide = false
	b.Size = Vector3.new(0.36,0.36,2.2)
	b.Material = Enum.Material.Neon
	b.Color = Color3.fromRGB(255,235,90)
	b.CFrame = CFrame.new(origin, origin + dir)
	b.Parent = bulletsFolder

	local l = Instance.new("PointLight")
	l.Brightness = 1.8; l.Range = 10; l.Color = b.Color; l.Parent = b

	local traveled = 0
	local con
	con = RunService.Heartbeat:Connect(function(dt)
		if not b.Parent then con:Disconnect() return end
		local step = speed*dt
		b.CFrame += b.CFrame.LookVector * step
		traveled += step

		if bulletHitCheck(b, damage) then con:Disconnect() return end
		if traveled >= maxDistance then b:Destroy(); con:Disconnect() end
	end)
end

